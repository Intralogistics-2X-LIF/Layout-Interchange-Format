digraph two_levels_of_a_facility_in_one_lif_file {
    layout=neato;
    overlap=true;
    splines=false;
    bgcolor="white";
    pad=0.02;
    node [fontname="Arial", fontcolor="black", penwidth=0];

    layout_upper_box [pos="247,268!", shape=box, style=dashed, color="black",
                       penwidth=2, fixedsize=true, width=7.36, height=1.81, label=""];
    layout_ground_box [pos="247,85!", shape=box, style=dashed, color="black",
                        penwidth=2, fixedsize=true, width=7.36, height=1.81, label=""];

    layout_upper_title [pos="125.8,308!", shape=plaintext, fontsize=24,
                         fixedsize=true, width=3.3, height=0.4, margin=0,
                         label="Layout_Upper_Level\l"];
    layout_ground_title [pos="129.4,125!", shape=plaintext, fontsize=24,
                          fixedsize=true, width=3.4, height=0.4, margin=0,
                          label="Layout_Ground_Level\l"];

    N101_label [pos="27,263!", shape=plaintext, label="N101", fontsize=22];
    N101       [pos="100,263!", shape=hexagon, style=filled, fillcolor="black",
                color="black", fixedsize=true, width=0.451, height=0.406, label=""];
    N102       [pos="418,263!", shape=hexagon, style=filled, fillcolor="black",
                color="black", fixedsize=true, width=0.451, height=0.406, label=""];
    N102_label [pos="467,263!", shape=plaintext, label="N102", fontsize=22];

    N1_label [pos="27,60!", shape=plaintext, label="N1", fontsize=22];
    N1       [pos="100,60!", shape=hexagon, style=filled, fillcolor="black",
              color="black", fixedsize=true, width=0.451, height=0.406, label=""];
    N2       [pos="418,60!", shape=hexagon, style=filled, fillcolor="black",
              color="black", fixedsize=true, width=0.451, height=0.406, label=""];
    N2_label [pos="467,60!", shape=plaintext, label="N2", fontsize=22];

    fwd101_start [pos="125,257!", shape=point, width=0.01, style=invis, label=""];
    fwd101_end   [pos="393,257!", shape=point, width=0.01, style=invis, label=""];
    fwd101_start -> fwd101_end [color="#70AD47", penwidth=4.5, arrowsize=1.78,
                                arrowhead=normal, arrowtail=none, dir=forward];

    bwd101_start [pos="393,269!", shape=point, width=0.01, style=invis, label=""];
    bwd101_end   [pos="125,269!", shape=point, width=0.01, style=invis, label=""];
    bwd101_start -> bwd101_end [color="#FF3131", penwidth=4.5, arrowsize=1.78,
                                arrowhead=normal, arrowtail=none, dir=forward];

    fwd1_start [pos="125,60!", shape=point, width=0.01, style=invis, label=""];
    fwd1_end   [pos="393,60!", shape=point, width=0.01, style=invis, label=""];
    fwd1_start -> fwd1_end [color="#70AD47", penwidth=4.5, arrowsize=1.78,
                            arrowhead=normal, arrowtail=none, dir=forward];

    vdown_start [pos="411,230!", shape=point, width=0.01, style=invis, label=""];
    vdown_end   [pos="411,93!",  shape=point, width=0.01, style=invis, label=""];
    vdown_start -> vdown_end [color="#70AD47", penwidth=4.5, arrowsize=1.78,
                              arrowhead=normal, arrowtail=none, dir=forward];

    vup_start [pos="425,93!",  shape=point, width=0.01, style=invis, label=""];
    vup_end   [pos="425,230!", shape=point, width=0.01, style=invis, label=""];
    vup_start -> vup_end [color="#70AD47", penwidth=4.5, arrowsize=1.78,
                          arrowhead=normal, arrowtail=none, dir=forward];

    legend_bg [pos="742.9,171.5!", shape=box, style=filled,
               fillcolor="#F2F2F2", color="#F2F2F2",
               fixedsize=true, width=6.177, height=2.57, label=""];

    legend_title [pos="562.5,239!", shape=plaintext, label="Legend:", fontsize=19];

    lg_start [pos="545.5,205!", shape=point, width=0.01, style=invis, label=""];
    lg_end   [pos="591.25,205!", shape=point, width=0.01, style=invis, label=""];
    lg_start -> lg_end [color="#70AD47", penwidth=4.5, arrowsize=1.78,
                        arrowhead=normal, arrowtail=none, dir=forward];
    legend_fwd_text [pos="801,205!", shape=plaintext, fontsize=19,
                     fixedsize=true, width=4.5, height=0.35, margin=0,
                     label="Edge: Mobile Robot Type 1 forward\l"];

    lr_start [pos="545.5,171!", shape=point, width=0.01, style=invis, label=""];
    lr_end   [pos="591.25,171!", shape=point, width=0.01, style=invis, label=""];
    lr_start -> lr_end [color="#FF3131", penwidth=4.5, arrowsize=1.78,
                        arrowhead=normal, arrowtail=none, dir=forward];
    legend_bwd_text [pos="801,171!", shape=plaintext, fontsize=19,
                     fixedsize=true, width=4.5, height=0.35, margin=0,
                     label="Edge: Mobile Robot Type 1 backward\l"];

    legend_node [pos="571.9,137!", shape=hexagon, style=filled, fillcolor="black",
                 color="black", fixedsize=true, width=0.451, height=0.406, label=""];
    legend_node_text [pos="801,137!", shape=plaintext, fontsize=19,
                      fixedsize=true, width=4.5, height=0.35, margin=0,
                      label="Node\l"];

    legend_layout_icon [pos="571.9,103!", shape=box, style=dashed, color="black",
                        penwidth=2, fixedsize=true, width=0.55, height=0.35, label=""];
    legend_layout_text [pos="801,103!", shape=plaintext, fontsize=19,
                        fixedsize=true, width=4.5, height=0.35, margin=0,
                        label="Layout\l"];
}
