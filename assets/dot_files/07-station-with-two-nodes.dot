digraph station_with_two_nodes {
    layout=neato;
    overlap=true;
    splines=false;
    bgcolor="white";
    pad=0.02;
    node [fontname="Arial", fontcolor="black", penwidth=0];

    station_box [pos="575,414.5!", shape=box, style=dashed, color="gray40",
                 penwidth=3, fixedsize=true, width=3.36, height=1.26, label=""];
    station_title [pos="575,478!", shape=plaintext, label="S01", fontsize=24];

    N11_label [pos="100,440!", shape=plaintext, label="N11", fontsize=22];
    N11       [pos="100,400!", shape=hexagon, style=filled, fillcolor="black",
               color="black", fixedsize=true, width=0.451, height=0.406, label=""];

    N1_label [pos="500,440!", shape=plaintext, label="N1", fontsize=22];
    N1       [pos="500,400!", shape=hexagon, style=filled, fillcolor="black",
              color="black", fixedsize=true, width=0.451, height=0.406, label=""];

    N2_label [pos="650,440!", shape=plaintext, label="N2", fontsize=22];
    N2       [pos="650,400!", shape=hexagon, style=filled, fillcolor="black",
              color="black", fixedsize=true, width=0.451, height=0.406, label=""];

    N3_label [pos="45,60!", shape=plaintext, label="N3", fontsize=22];
    N3       [pos="100,60!", shape=hexagon, style=filled, fillcolor="black",
              color="black", fixedsize=true, width=0.451, height=0.406, label=""];

    N21_label [pos="710,60!", shape=plaintext, label="N21", fontsize=22];
    N21       [pos="650,60!", shape=hexagon, style=filled, fillcolor="black",
               color="black", fixedsize=true, width=0.451, height=0.406, label=""];

    r1_start [pos="124,400!", shape=point, width=0.01, style=invis, label=""];
    r1_end   [pos="476,400!", shape=point, width=0.01, style=invis, label=""];
    r1_start -> r1_end [color="#FF3131", penwidth=4.5, arrowsize=1.78,
                        arrowhead=normal, arrowtail=none, dir=forward];

    g1_start [pos="100,84!",  shape=point, width=0.01, style=invis, label=""];
    g1_end   [pos="100,376!", shape=point, width=0.01, style=invis, label=""];
    g1_start -> g1_end [color="#70AD47", penwidth=4.5, arrowsize=1.78,
                        arrowhead=normal, arrowtail=none, dir=forward];

    r2_start [pos="650,84!",  shape=point, width=0.01, style=invis, label=""];
    r2_end   [pos="650,376!", shape=point, width=0.01, style=invis, label=""];
    r2_start -> r2_end [color="#FF3131", penwidth=4.5, arrowsize=1.78,
                        arrowhead=normal, arrowtail=none, dir=forward];

    g2_start [pos="626,60!", shape=point, width=0.01, style=invis, label=""];
    g2_end   [pos="124,60!", shape=point, width=0.01, style=invis, label=""];
    g2_start -> g2_end [color="#70AD47", penwidth=4.5, arrowsize=1.78,
                        arrowhead=normal, arrowtail=none, dir=forward];

    c1_curve_start [pos="487.8,389.6!", shape=point, width=0.01, style=invis, label=""];
    c1_curve_end   [pos="124.5,82.85!", shape=point, width=0.01, style=invis, label=""];
    c1_curve_start -> c1_curve_end [color="#70AD47", penwidth=4.5, arrowsize=1.78,
                        arrowhead=none, arrowtail=none, dir=forward,
                        pos="487.8,389.6 350,370 150,150 124.5,82.85"];
    c1_tip_start [pos="124.5,82.85!", shape=point, width=0.01, style=invis, label=""];
    c1_tip_end   [pos="120,71!", shape=point, width=0.01, style=invis, label=""];
    c1_tip_start -> c1_tip_end [color="#70AD47", penwidth=4.5, arrowsize=1.78,
                        arrowhead=normal, arrowtail=none, dir=forward];

    c2_curve_start [pos="636.4,391.6!", shape=point, width=0.01, style=invis, label=""];
    c2_curve_end   [pos="137.9,70.58!", shape=point, width=0.01, style=invis, label=""];
    c2_curve_start -> c2_curve_end [color="#70AD47", penwidth=4.5, arrowsize=1.78,
