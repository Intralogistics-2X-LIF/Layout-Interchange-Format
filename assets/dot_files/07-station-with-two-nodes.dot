    legend_title [pos="970,355.5!", shape=plaintext, label="Legend:", fontsize=19];

    lg_start [pos="953,321.5!", shape=point, width=0.01, style=invis, label=""];
    lg_end   [pos="998.75,321.5!", shape=point, width=0.01, style=invis, label=""];
    lg_start -> lg_end [color="#70AD47", penwidth=4.5, arrowsize=1.78,
