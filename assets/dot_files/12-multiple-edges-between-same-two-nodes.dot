digraph multiple_edges_between_same_two_nodes {
    layout=neato;
    overlap=true;
    splines=false;
    bgcolor="white";
    pad=0.02;
    node [fontname="Arial", fontcolor="black", penwidth=0];

    legend_bg [pos="881,87!", shape=box, style=filled,
               fillcolor="#F2F2F2", color="#F2F2F2",
               fixedsize=true, width=10.6, height=2.7, label=""];

    N0       [pos="60,65!", shape=hexagon, style=filled, fillcolor="black",
              color="black", fixedsize=true, width=0.451, height=0.406, label=""];
    N0_label [pos="60,25.5!",  shape=plaintext, label="N0", fontsize=22];
    N1       [pos="310,65!", shape=hexagon, style=filled, fillcolor="black",
              color="black", fixedsize=true, width=0.451, height=0.406, label=""];
    N1_label [pos="310,25.5!",   shape=plaintext, label="N1", fontsize=22];

    green_start [pos="90,85.5!", shape=point, width=0.01, style=invis, label=""];
    green_end   [pos="280,85.5!", shape=point, width=0.01, style=invis, label=""];
    green_start -> green_end [color="#70AD47", penwidth=4.5, arrowsize=1.78,
                              arrowhead=normal, arrowtail=none, dir=forward];

    red_start [pos="90,65.5!", shape=point, width=0.01, style=invis, label=""];
    red_end   [pos="280,65.5!", shape=point, width=0.01, style=invis, label=""];
    red_start -> red_end [color="#FF3131", penwidth=4.5, arrowsize=1.78,
                          arrowhead=normal, arrowtail=none, dir=forward];

    yellow_start [pos="90,45.5!", shape=point, width=0.01, style=invis, label=""];
    yellow_end   [pos="280,45.5!", shape=point, width=0.01, style=invis, label=""];
    yellow_start -> yellow_end [color="#B8860B", penwidth=4.5, arrowsize=1.78,
                                arrowhead=normal, arrowtail=none, dir=forward];

    legend_title [pos="550,168!", shape=plaintext, label="Legend:", fontsize=19];

    leg_g_start [pos="525,136!", shape=point, width=0.01, style=invis, label=""];
    leg_g_end   [pos="570.5,136!", shape=point, width=0.01, style=invis, label=""];
    leg_g_start -> leg_g_end [color="#70AD47", penwidth=4.5, arrowsize=1.78,
                        arrowhead=normal, arrowtail=none, dir=forward];
    legend_green_text [pos="927.85,136!", shape=plaintext, fontsize=19,
                      fixedsize=true, width=8.6, height=0.35, margin=0,
                      label="Edge: Mobile Robot Type 1 unloaded only, no maxSpeed defined\l"];

    leg_r_start [pos="525,103!", shape=point, width=0.01, style=invis, label=""];
    leg_r_end   [pos="570.5,103!", shape=point, width=0.01, style=invis, label=""];
    leg_r_start -> leg_r_end [color="#FF3131", penwidth=4.5, arrowsize=1.78,
                        arrowhead=normal, arrowtail=none, dir=forward];
    legend_red_text [pos="927.85,103!", shape=plaintext, fontsize=19,
                      fixedsize=true, width=8.6, height=0.35, margin=0,
                      label="Edge: Mobile Robot Type 1 loaded loadSetStable, maxSpeed: 0.8\l"];

    leg_y_start [pos="525,70!", shape=point, width=0.01, style=invis, label=""];
    leg_y_end   [pos="570.5,70!", shape=point, width=0.01, style=invis, label=""];
    leg_y_start -> leg_y_end [color="#B8860B", penwidth=4.5, arrowsize=1.78,
                        arrowhead=normal, arrowtail=none, dir=forward];
    legend_yellow_text [pos="927.85,70!", shape=plaintext, fontsize=19,
                      fixedsize=true, width=8.6, height=0.35, margin=0,
                      label="Edge: Mobile Robot Type 1 loaded loadSetUnstable, maxSpeed: 0.3\l"];

    legend_node [pos="545,30!", shape=hexagon, style=filled, fillcolor="black",
                 color="black", fixedsize=true, width=0.451, height=0.406, label=""];
    legend_node_text [pos="927.85,30.75!", shape=plaintext, fontsize=19,
                      fixedsize=true, width=8.6, height=0.35, margin=0,
                      label="Node\l"];
}
