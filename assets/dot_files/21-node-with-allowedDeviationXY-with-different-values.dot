digraph node_with_allowedDeviationXY_as_a_fixed_ellipse {
    layout=neato;
    overlap=true;
    splines=false;
    bgcolor="white";
    pad=0.1;
    node [fontname="Arial", fontcolor="black", penwidth=0];

    ellipse_outer [pos="450,300!", shape=ellipse, style="", color="black",
                   penwidth=1.2, fixedsize=true, width=6.111, height=4.722, label=""];
    ellipse_inner [pos="450,300!", shape=ellipse, style=dashed, color="black",
                   penwidth=1.2, fixedsize=true, width=3.472, height=2.639, label=""];

    a_line_s [pos="450,300!", shape=point, width=0.01, style=invis, label=""];
    a_line_e [pos="670,300!", shape=point, width=0.01, style=invis, label=""];
    a_line_s -> a_line_e [color="black", penwidth=1, arrowhead=none, arrowtail=none, dir=none];
    a_min_label [pos="520,308!", shape=plaintext, label="aMinimum", fontsize=16];
    a_max_label [pos="622.5,308!", shape=plaintext, label="aMaximum", fontsize=16];

    b_line_s [pos="450,300!", shape=point, width=0.01, style=invis, label=""];
    b_line_e [pos="450,470!", shape=point, width=0.01, style=invis, label=""];
    b_line_s -> b_line_e [color="black", penwidth=1, arrowhead=none, arrowtail=none, dir=none];
    b_min_label [pos="400,347.5!", shape=plaintext, label="bMinimum", fontsize=16];
    b_max_label [pos="400,432.5!", shape=plaintext, label="bMaximum", fontsize=16];

    N1_label [pos="100,355!", shape=plaintext, label="N1", fontsize=22];
    N1       [pos="100,300!", shape=octagon, style=filled, fillcolor="black",
              color="black", fixedsize=true, width=0.75, height=0.75, label=""];
    N2_label [pos="450,247!", shape=plaintext, label="N2", fontsize=22];
    N2       [pos="450,300!", shape=octagon, style=filled, fillcolor="black",
              color="black", fixedsize=true, width=0.75, height=0.75, label=""];
    N3_label [pos="695,505!", shape=plaintext, label="N3", fontsize=22];
    N3       [pos="650,480!", shape=octagon, style=filled, fillcolor="black",
              color="black", fixedsize=true, width=0.75, height=0.75, label=""];

    e1_start [pos="135,300!", shape=point, width=0.01, style=invis, label=""];
    e1_end   [pos="415,300!", shape=point, width=0.01, style=invis, label=""];
    e1_start -> e1_end [color="#70AD47", penwidth=4.5, arrowsize=1.78,
                        arrowhead=normal, arrowtail=none, dir=forward];

    e2_start [pos="476.02,323.41!", shape=point, width=0.01, style=invis, label=""];
    e2_end   [pos="623.98,456.59!", shape=point, width=0.01, style=invis, label=""];
    e2_start -> e2_end [color="#70AD47", penwidth=4.5, arrowsize=1.78,
                        arrowhead=normal, arrowtail=none, dir=forward];

    legend_bg [pos="1150,300!", shape=box, style=filled,
               fillcolor="#F2F2F2", color="#F2F2F2",
               fixedsize=true, width=6.177, height=3.2, label=""];

    legend_title [pos="970,380!", shape=plaintext, label="Legend:", fontsize=19];

    lf_start [pos="953,346!", shape=point, width=0.01, style=invis, label=""];
    lf_end   [pos="998.75,346!", shape=point, width=0.01, style=invis, label=""];
    lf_start -> lf_end [color="#70AD47", penwidth=4.5, arrowsize=1.78,
                        arrowhead=normal, arrowtail=none, dir=forward];
    legend_fwd_text [pos="1208.75,346!", shape=plaintext, fontsize=19,
                     fixedsize=true, width=4.5, height=0.35, margin=0,
                     label="Edge: Mobile Robot Type 1 forward\l"];

    legend_node [pos="979.4,312!", shape=octagon, style=filled, fillcolor="black",
                 color="black", fixedsize=true, width=0.451, height=0.406, label=""];
    legend_node_text [pos="1208.75,312!", shape=plaintext, fontsize=19,
                      fixedsize=true, width=4.5, height=0.35, margin=0,
                      label="Node\l"];

    legend_outer [pos="979.4,278!", shape=ellipse, color="black",
                  penwidth=1.2, fixedsize=true, width=0.65, height=0.4, label=""];
    legend_outer_text [pos="1208.75,278!", shape=plaintext, fontsize=19,
                       fixedsize=true, width=4.5, height=0.35, margin=0,
                       label="Outer ellipse: aMaximum/bMaximum\l"];

    legend_inner [pos="979.4,244!", shape=ellipse, style=dashed, color="black",
                  penwidth=1.2, fixedsize=true, width=0.65, height=0.4, label=""];
    legend_inner_text [pos="1208.75,244!", shape=plaintext, fontsize=19,
                       fixedsize=true, width=4.5, height=0.35, margin=0,
                       label="Inner ellipse: aMinimum/bMinimum\l"];
}
