digraph edge_with_physicalLineGuidedProperty {
    layout=neato;
    overlap=true;
    splines=false;
    bgcolor="white";
    pad=0.1;
    node [fontname="Arial", fontcolor="black", penwidth=0];

    N1_label [pos="60,345!", shape=plaintext, label="N1", fontsize=22];
    N1       [pos="60,300!", shape=octagon, style=filled, fillcolor="black",
              color="black", fixedsize=true, width=0.75, height=0.75, label=""];
    N2_label [pos="400,345!", shape=plaintext, label="N2", fontsize=22];
    N2       [pos="400,300!", shape=octagon, style=filled, fillcolor="black",
              color="black", fixedsize=true, width=0.75, height=0.75, label=""];
    N3_label [pos="700,525!", shape=plaintext, label="N3", fontsize=22];
    N3       [pos="700,480!", shape=octagon, style=filled, fillcolor="black",
              color="black", fixedsize=true, width=0.75, height=0.75, label=""];
    N4_label [pos="700,165!", shape=plaintext, label="N4", fontsize=22];
    N4       [pos="700,120!", shape=octagon, style=filled, fillcolor="black",
              color="black", fixedsize=true, width=0.75, height=0.75, label=""];

    e1_start [pos="95,300!", shape=point, width=0.01, style=invis, label=""];
    e1_end   [pos="365,300!", shape=point, width=0.01, style=invis, label=""];
    e1_start -> e1_end [color="#70AD47", penwidth=4.5, arrowsize=1.78,
                        arrowhead=normal, arrowtail=none, dir=forward];

    e2_start [pos="430.01,318.01!", shape=point, width=0.01, style=invis, label=""];
    e2_end   [pos="669.99,461.99!", shape=point, width=0.01, style=invis, label=""];
    e2_start -> e2_end [color="#70AD47", penwidth=4.5, arrowsize=1.78,
                        arrowhead=normal, arrowtail=none, dir=forward];

    e3_start [pos="430.01,281.99!", shape=point, width=0.01, style=invis, label=""];
    e3_end   [pos="669.99,138.01!", shape=point, width=0.01, style=invis, label=""];
    e3_start -> e3_end [color="#70AD47", penwidth=4.5, arrowsize=1.78,
                        arrowhead=normal, arrowtail=none, dir=forward];

    label_left [pos="500,420!", shape=invhouse, style=filled, fillcolor="white",
                color="black", penwidth=1.2, fixedsize=true, width=1.9, height=0.7,
                fontsize=13, fontname="Arial",
                label="direction: \"left\"\nlength: \"2.0\""];

    label_right [pos="500,180!", shape=house, style=filled, fillcolor="white",
                 color="black", penwidth=1.2, fixedsize=true, width=1.9, height=0.7,
                 fontsize=13, fontname="Arial",
                 label="direction: \"right\"\nlength: \"2.0\""];

    legend_bg [pos="1150,312.5!", shape=box, style=filled,
               fillcolor="#F2F2F2", color="#F2F2F2",
               fixedsize=true, width=6.177, height=1.833, label=""];

    legend_title [pos="970,353.5!", shape=plaintext, label="Legend:", fontsize=19];

    lf_start [pos="953,319.5!", shape=point, width=0.01, style=invis, label=""];
    lf_end   [pos="998.75,319.5!", shape=point, width=0.01, style=invis, label=""];
    lf_start -> lf_end [color="#70AD47", penwidth=4.5, arrowsize=1.78,
                        arrowhead=normal, arrowtail=none, dir=forward];
    legend_fwd_text [pos="1208.75,319.5!", shape=plaintext, fontsize=19,
                     fixedsize=true, width=4.5, height=0.35, margin=0,
                     label="Forward Edge\l"];

    legend_node [pos="979.4,285.5!", shape=octagon, style=filled, fillcolor="black",
                 color="black", fixedsize=true, width=0.451, height=0.406, label=""];
    legend_node_text [pos="1208.75,285.5!", shape=plaintext, fontsize=19,
                      fixedsize=true, width=4.5, height=0.35, margin=0,
                      label="Node\l"];
}
