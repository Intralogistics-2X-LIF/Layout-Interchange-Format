digraph manufacturer_specific_action_on_an_edge {
    layout=neato;
    overlap=true;
    splines=false;
    bgcolor="white";
    pad=0.02;
    node [fontname="Arial", fontcolor="black", penwidth=0];

    N1_label [pos="27,60!", shape=plaintext, label="N1", fontsize=22];
    N1       [pos="100,60!", shape=hexagon, style=filled, fillcolor="black",
              color="black", fixedsize=true, width=0.451, height=0.406, label=""];
    N2       [pos="418,60!", shape=hexagon, style=filled, fillcolor="black",
              color="black", fixedsize=true, width=0.451, height=0.406, label=""];
    N2_label [pos="467,60!", shape=plaintext, label="N2", fontsize=22];

    fwd_start [pos="125,69!", shape=point, width=0.01, style=invis, label=""];
    fwd_end   [pos="393,69!", shape=point, width=0.01, style=invis, label=""];
    fwd_start -> fwd_end [color="#70AD47", penwidth=4.5, arrowsize=1.78,
                          arrowhead=normal, arrowtail=none, dir=forward];

    bwd_start [pos="393,51!", shape=point, width=0.01, style=invis, label=""];
    bwd_end   [pos="125,51!", shape=point, width=0.01, style=invis, label=""];
    bwd_start -> bwd_end [color="#FF3131", penwidth=4.5, arrowsize=1.78,
                          arrowhead=normal, arrowtail=none, dir=forward];

    legend_bg [pos="926.8,60!", shape=box, style=filled,
               fillcolor="#F2F2F2", color="#F2F2F2",
               fixedsize=true, width=11.3, height=2.18, label=""];

    legend_title [pos="562.5,113.5!", shape=plaintext, label="Legend:", fontsize=19];

    lg_start [pos="545.5,79.5!", shape=point, width=0.01, style=invis, label=""];
    lg_end   [pos="591.25,79.5!", shape=point, width=0.01, style=invis, label=""];
    lg_start -> lg_end [color="#70AD47", penwidth=4.5, arrowsize=1.78,
                        arrowhead=normal, arrowtail=none, dir=forward];
    legend_fwd_text [pos="973.8,79.5!", shape=plaintext, fontsize=19,
                     fixedsize=true, width=9.3, height=0.35, margin=0,
                     label="Edge: Mobile Robot Type 1 forward, action: BEEP\l"];

    lr_start [pos="545.5,45.5!", shape=point, width=0.01, style=invis, label=""];
    lr_end   [pos="591.25,45.5!", shape=point, width=0.01, style=invis, label=""];
    lr_start -> lr_end [color="#FF3131", penwidth=4.5, arrowsize=1.78,
                        arrowhead=normal, arrowtail=none, dir=forward];
    legend_bwd_text [pos="973.8,45.5!", shape=plaintext, fontsize=19,
                     fixedsize=true, width=9.3, height=0.35, margin=0,
                     label="Edge: Mobile Robot Type 1 backward, action: LOWER_FORK_AND_BEEP\l"];

    legend_node [pos="571.9,11.5!", shape=hexagon, style=filled, fillcolor="black",
                 color="black", fixedsize=true, width=0.451, height=0.406, label=""];
    legend_node_text [pos="973.8,11.5!", shape=plaintext, fontsize=19,
                      fixedsize=true, width=9.3, height=0.35, margin=0,
                      label="Node\l"];
}